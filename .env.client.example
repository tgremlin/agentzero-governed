APP_PORT=50001
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
POSTGRES_DB=agentzero
POSTGRES_USER=agentzero
POSTGRES_PASSWORD=agentzero
APP_IMAGE_NAME=agentzero-governed
A0_DATA_DIR=./client-data
# Required when accessing from non-localhost browser origins.
# Example includes localhost plus one LAN origin:
# ALLOWED_ORIGINS=http://localhost:50001,http://127.0.0.1:50001,http://192.168.10.121:50001
# Optional integrations:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# GH_TOKEN=ghp_...
# SLACK_SOCKET_ENABLED=false
# SLACK_SOCKET_MODE=both
# SLACK_SOCKET_REPLY_IN_THREAD=true
# SLACK_CONTEXT_LIFETIME_HOURS=720
# SLACK_A0_API_URL=http://app:5000
# SLACK_PROJECT_NAME=
